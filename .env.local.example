# === Anthropic (script generation, StepChat, translation) ===
ANTHROPIC_API_KEY=

# === OpenAI (gpt-image-2: keyframe + per-scene images) ===
OPENAI_API_KEY=
# Override if gpt-image-2 isn't on your account yet (e.g. gpt-image-1)
# OPENAI_IMAGE_MODEL=gpt-image-2

# === fal (image-to-video; default MiniMax video-01, model-swappable) ===
FAL_KEY=
# Override the fal model endpoint (default fal-ai/minimax/video-01)
# FAL_VIDEO_MODEL=fal-ai/kling-video/v1/standard/image-to-video

# === ElevenLabs (TTS voiceover; optional, toggleable in UI) ===
ELEVENLABS_API_KEY=

# === State + assets ===
# Upstash Redis (project state, step machine, job queue)
# Upstash 콘솔 REST API 섹션 .env 복사값 그대로 붙여넣기. cardnews 와 별도 DB 권장.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Blob (images / video / audio assets)
BLOB_READ_WRITE_TOKEN=

# === Worker coordination ===
# The separate always-on worker (Render/Railway/Fly) reads the same Redis.
# Shared secret so the Vercel app can enqueue and the worker can authenticate.
WORKER_SHARED_SECRET=
