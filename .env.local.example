# === Anthropic (script generation, StepChat, translation) ===
ANTHROPIC_API_KEY=

# === OpenAI (gpt-image-2: keyframe + per-scene images) ===
OPENAI_API_KEY=
# Override if gpt-image-2 isn't on your account yet (e.g. gpt-image-1)
# OPENAI_IMAGE_MODEL=gpt-image-2

# === fal (image-to-video; default MiniMax video-01, model-swappable) ===
FAL_KEY=
# Override the fal model endpoint (default fal-ai/minimax-video/image-to-video)
# FAL_VIDEO_MODEL=fal-ai/bytedance/seedance/v1/pro/image-to-video

# === xAI (Grok) — fal 대안 비디오 (grok-imagine-video, 720p 프리뷰) ===
# fal 장애·콘텐츠 차단 시 교차용. console.x.ai 에서 발급.
XAI_API_KEY=

# === ElevenLabs (TTS voiceover; optional, toggleable in UI) ===
ELEVENLABS_API_KEY=
# Voice for narration (default EXAVITQu4vr4xnSDxMaL). model=eleven_multilingual_v2
# 한국어 품질은 voice 마다 다름 — ElevenLabs Voice Library 에서 한국어 추천 voice 의
# ID 로 교체 권장.
# ELEVENLABS_VOICE_ID=

# === State + assets ===
# Upstash Redis (project state, step machine, job queue)
# Upstash 콘솔 REST API 섹션 .env 복사값 그대로 붙여넣기. cardnews 와 별도 DB 권장.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Blob (images / video / audio assets)
BLOB_READ_WRITE_TOKEN=

# === Worker coordination ===
# The separate always-on worker (Render/Railway/Fly) reads the same Redis.
# Shared secret so the Vercel app can enqueue and the worker can authenticate.
WORKER_SHARED_SECRET=
