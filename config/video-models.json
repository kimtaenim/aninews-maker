      "defaultParams": {}
    },
    {
      "id": "grok",
      "provider": "grok",
      "label": "Grok Imagine (xAI · 정책 느슨, fal 대안)",
      "endpoint": "grok-imagine-video",
      "defaultParams": {}
    }
  ]
