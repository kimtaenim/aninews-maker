    {
      "id": "minimax",
      "provider": "fal",
      "label": "MiniMax (fal · 가성비)",
      "endpoint": "fal-ai/minimax-video/image-to-video",
      "defaultParams": {}
    },
    {
      "id": "seedance",
      "provider": "fal",
      "label": "Seedance Pro (fal · 고품질)",
